services:

  nginx:
    container_name: beartrando-nginx
    build: ./services/nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./services/certbot/conf:/etc/letsencrypt
      - ./services/certbot/www:/var/www/certbot
      - ./services/nginx/config/wiki.conf:/etc/nginx/conf.d/wiki.conf:ro
      - ./services/nginx/config/vault.conf:/etc/nginx/conf.d/vault.conf:ro
      - ./services/nginx/config/site.conf:/etc/nginx/conf.d/site.conf:ro
      - ./services/nginx/config/mail.conf:/etc/nginx/conf.d/mail.conf:ro
      - ./services/nginx/config/vipp.conf:/etc/nginx/conf.d/vipp.conf:ro
      - ./services/nginx/config/tiny.conf:/etc/nginx/conf.d/tiny.conf:ro
      - ./services/nginx/config/tic-tac-toe.conf:/etc/nginx/conf.d/tic-tac-toe.conf:ro
      - ./services/nginx/config/tic-tac-toe-streaming.conf:/etc/nginx/conf.d/tic-tac-toe-streaming.conf:ro
      - ./services/nginx/config/lenvora.conf:/etc/nginx/conf.d/lenvora.conf:ro
      - ./services/nginx/config/lenvora-streaming.conf:/etc/nginx/conf.d/lenvora-streaming.conf:ro
      - ./services/nginx/logs:/etc/logs/nginx
      - ./services/nginx/html:/usr/share/nginx/html
    command: '/bin/sh -c ''while :; do sleep 6h & wait $${!}; nginx -s reload; done & nginx -g "daemon off;"'''
    depends_on:
      - wiki
      - vault
    networks:
      - default
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test: [ "CMD-SHELL", "curl -kfs --resolve beartrando.org:443:127.0.0.1 https://beartrando.org/ || exit 1" ]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s

  certbot:
    image: certbot/certbot
    container_name: beartrando-certbot
    restart: unless-stopped
    volumes:
      - ./services/certbot/conf:/etc/letsencrypt
      - ./services/certbot/www:/var/www/certbot
    entrypoint: >
      sh -c "trap exit TERM;
             while :; do
               certbot renew --webroot -w /var/www/certbot;
               sleep 12h & wait $!;
             done"
    networks:
      - default
    healthcheck:
      test: ["CMD", "certbot", "--version"]
      interval: 12h
      timeout: 10s
      retries: 3
      start_period: 30s

  vault:
    image: vaultwarden/server:latest
    container_name: beartrando-vault
    restart: unless-stopped
    env_file:
      - ./services/vault/conf/.env
    volumes:
      - ./services/vault/data:/data
    networks:
      - default
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

  wiki:
    image: requarks/wiki:latest
    container_name: beartrando-wiki
    restart: unless-stopped
    environment:
      DB_TYPE: postgres
      DB_HOST: $POSTGRES_HOST
      DB_PORT: $POSTGRES_PORT
      DB_USER: $POSTGRES_USER
      DB_PASS: $POSTGRES_PASSWORD
      DB_NAME: $POSTGRES_DB
    networks:
      - default
    healthcheck:
      test: [ "CMD-SHELL", "curl -sf http://localhost:3000/ || exit 1" ]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s

  postgres:
    image: postgres:17.6
    container_name: beartrando-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: $POSTGRES_USER
      POSTGRES_PASSWORD: $POSTGRES_PASSWORD
      POSTGRES_DB: $POSTGRES_DB
    volumes:
      - ./services/postgres/data:/var/lib/postgresql/data
    networks:
      - default
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s

  mailpit:
    image: axllent/mailpit
    container_name: beartrando-mailpit
    restart: unless-stopped
    environment:
#      MP_SMTP_AUTH_ACCEPT_ANY: 1
      MP_SMTP_AUTH_ALLOW_INSECURE: 1
      MP_SMTP_AUTH: "login:pass"
      MP_MAX_MESSAGES: 5000
      MP_UI_AUTH: "login:pass"
    volumes:
      - ./services/mailpit/data:/data
    networks:
      - default
    healthcheck:
      test: ["CMD-SHELL", "/mailpit version >/dev/null 2>&1 || exit 0"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s


networks:
  default:
    driver: bridge
