services:

  nginx:
    container_name: beartrando-nginx
    build: ./services/nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./services/certbot/conf:/etc/letsencrypt
      - ./services/certbot/www:/var/www/certbot
      - ./services/nginx/config/wiki.conf:/etc/nginx/conf.d/wiki.conf:ro
      - ./services/nginx/config/vaultwarden.conf:/etc/nginx/conf.d/vaultwarden.conf:ro
      - ./services/nginx/config/site.conf:/etc/nginx/conf.d/site.conf:ro
      - ./services/nginx/config/mail.conf:/etc/nginx/conf.d/mail.conf:ro
      - ./services/nginx/logs:/etc/logs/nginx
      - ./services/nginx/html:/usr/share/nginx/html
    command: '/bin/sh -c ''while :; do sleep 6h & wait $${!}; nginx -s reload; done & nginx -g "daemon off;"'''
    depends_on:
      - wiki
      - vaultwarden
    networks:
      - default

  certbot:
    image: certbot/certbot
    container_name: certbot
    volumes:
      - ./services/certbot/conf:/etc/letsencrypt
      - ./services/certbot/www:/var/www/certbot
    entrypoint: >
      sh -c "trap exit TERM;
             while :; do
               certbot renew --webroot -w /var/www/certbot;
               sleep 12h & wait $!;
             done"
    networks:
      - default

  vaultwarden:
    image: vaultwarden/server:latest
    container_name: beartrando-vaultwarden
    restart: unless-stopped
    env_file:
      - ./services/vaultwarden/conf/.env
#    ports:
#      - "8081:80"
    volumes:
      - ./services/vaultwarden/data:/data
    networks:
      - default

  wiki:
    image: requarks/wiki:latest
    container_name: beartrando-wikijs
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      DB_TYPE: postgres
      DB_HOST: $POSTGRES_HOST
      DB_PORT: $POSTGRES_PORT
      DB_USER: $POSTGRES_USER
      DB_PASS: $POSTGRES_PASSWORD
      DB_NAME: $POSTGRES_DB
    networks:
      - default

  postgres:
    image: postgres:17.6
    container_name: beartrando-wikijs-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: $POSTGRES_USER
      POSTGRES_PASSWORD: $POSTGRES_PASSWORD
      POSTGRES_DB: $POSTGRES_DB
    volumes:
      - ./services/postgres/data:/var/lib/postgresql/data
    networks:
      - default

  mailpit:
    image: axllent/mailpit
    container_name: beartrando-mailpit
    ports:
      - 8025:8025
      - 1025:1025
    environment:
#      MP_SMTP_AUTH_ACCEPT_ANY: 1
      MP_SMTP_AUTH_ALLOW_INSECURE: 1
      MP_SMTP_AUTH: "login:pass"
      MP_MAX_MESSAGES: 5000
      MP_UI_AUTH: "login:pass"
    volumes:
      - ./services/mailpit/data:/data
    networks:
      - default
    restart: always
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5


networks:
  default:
    driver: bridge
